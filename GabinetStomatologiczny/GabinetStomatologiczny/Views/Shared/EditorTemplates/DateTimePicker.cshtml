@model DateTime?

@{
    var uid = Guid.NewGuid();
}

@Html.TextBox(
    string.Empty,
    Model.HasValue ? Model.Value.ToString("yyyy.MM.dd") : string.Empty,
    new { @id = uid, placeholder = "yyyy.mm.dd", autocomplete = "off" })
<script type="text/javascript">

    function wypisz() {
        $("#@uid").datepicker(
           {
               dateFormat: 'yy.mm.dd',
               yearRange: "-100:+0",
               changeMonth: true,
               changeYear: true,
               selectOtherMonths: true,
               showAnim: 'slideDown'
           }
        ).addClass("form-control dataUrodzeniaPacjenta");
    }
    wypisz();

    $(function () {

        let error = $("input.dataUrodzeniaPacjenta");
        error.bind('click focus blur keyup keydown keypress', function () {
            if ($(this).hasClass('input-validation-error')) {
                $(this).next().next().children().html('Wybrana data jest niepoprawna');
            }
        })
    });

</script>