@model PagedList.IPagedList<GabinetStomatologiczny.DAO.Models.Lekarz>
@{
    ViewBag.Title = "Lekarze";
    ViewBag.Active = "Pacjenci";
}


<header class="alert alert-info headerInfo"><div>Lekarze</div></header>

@if (TempData["editLekarz"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        Pomyślnie edytowano
    </div>
}

<form id="wyslij" class="wyszukiwarka" method="get" data-ajax="true">
    <div class="form-group">
        <div class="col-12">
            <span id="searchclear" class="glyphicon glyphicon-remove-circle kasujText kasujTextLekarz"></span>
            <input type="text" id="searchQuery" name="searchQuery" data-autocomplete-source="@Url.Action("SugestionsLekarzs")"
                   placeholder="Wpisz min 1 znak" class="form-control lekarz-query" />
            <button type="submit" data-toggle="tooltip" title="Wyszukaj" class="szukajLekarzaAjax form-control tooltipLink"><i class="fa fa-search"></i></button>
        </div>
    </div>
</form>

@Html.Partial("_LekarzsParts")

@section MyCustomStyle{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/Content/Lekarzs.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Zdjecia.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/TableStyle.min.css")" rel="stylesheet" />
    <link href="~/Content/Wyszukiwarka.min.css" rel="stylesheet" />
    <link href="~/Content/PginationPosition.min.css" rel="stylesheet" />
}


@section scripts{
    <script src="~/Scripts/custom/WyszukiwanieAjaxowe.es5.min.js"></script>
    <script src="~/Scripts/custom/Zdjecia.es5.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/custom/AutoComplete.es5.min.js"></script>
}
