@model List<GabinetStomatologiczny.Models.LiczbaPacjentow>

@{
    ViewBag.Active = "About";
    ViewBag.Title = "Statystki";
}

<h2>Pacjenci</h2>


<div style="margin-bottom: 20px;">
    Genruj PDF :
    <a href="Pdf" target="_blank" class="btn btn-success">
        <span class="glyphicon glyphicon-print"></span> Drukuj
    </a>
</div>

<div class="ladowanie"></div>

<div class="row">
    <div style="height: 100%; width: 100%;" id="statisticChart">
        <div class="canvasjs-chart-container" style="position: relative; text-align: left; cursor: pointer; overflow: hidden;">
            <canvas id="myChart"> </canvas>
        </div>
    </div>
</div>

@section MyCustomStyle{
    <link href="~/Content/TableStyle.min.css" rel="stylesheet" />
    <link href="~/Content/About.min.css" rel="stylesheet" />
}

@section scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.6.0/Chart.min.js" type="text/javascript"></script>  
    <script src="~/Content/script/Chart.js"></script>
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>
}
