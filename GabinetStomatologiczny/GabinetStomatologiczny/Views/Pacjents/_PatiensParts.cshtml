@model PagedList.IPagedList<GabinetStomatologiczny.DAO.Models.Pacjent>
@using PagedList.Mvc;
@using Microsoft.AspNet.Identity


<div class="ladowanie"></div>
@if (Model.Count > 0)
{
    <div class="data-select">
        <table class="table">
            <tr>
                <th>Imie</th>
                <th>Nazwisko</th>
                <th>Pesel</th>
                <th>Płeć</th>
                <th>Data urodzenia</th>
                <th>Nr tel.</th>
                <th>Data rejestracji</th>
                <th>Akcja</th>
            </tr>
            <tr>
                <td>
                    @Html.ActionLink("↑", "Index", new { sortOrder = "name_desc", currentFilter = ViewBag.CurrentFilter }
                    , new { @class= @ViewBag.ClassIsActive, title = "Rosnąco" })
                    @Html.ActionLink("↓", "Index", new { sortOrder = "name_asc", currentFilter = ViewBag.CurrentFilter },
                    new { Class = "Action", title = "Malejąco" })
                </td>
                <td>
                    @Html.ActionLink("↑", "Index", new { sortOrder = "surname_desc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Rosnąco" })
                    @Html.ActionLink("↓", "Index", new { sortOrder = "surname_asc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Malejąco" })
                </td>
                <td>
                    @Html.ActionLink("↑", "Index", new { sortOrder = "pesel_desc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Rosnąco" })
                    @Html.ActionLink("↓", "Index", new { sortOrder = "pesel_asc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Malejąco" })
                </td>
                <td>
                    @Html.ActionLink("↑", "Index", new { sortOrder = "plec_desc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Rosnąco" })
                    @Html.ActionLink("↓", "Index", new { sortOrder = "plec_asc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Malejąco" })
                </td>
                <td>
                    @Html.ActionLink("↑", "Index", new { sortOrder = "dataurodzenia_desc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Rosnąco" })
                    @Html.ActionLink("↓", "Index", new { sortOrder = "dataurodzenia_asc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Malejąco" })
                </td>
                <td>
                    @Html.ActionLink("↑", "Index", new { sortOrder = "nrtel_desc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Rosnąco" })
                    @Html.ActionLink("↓", "Index", new { sortOrder = "nrtel_asc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Malejąco" })
                </td>
                <td colspan="2">
                    @Html.ActionLink("↑", "Index", new { sortOrder = "datarejestracji_desc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Rosnąco" })
                    @Html.ActionLink("↓", "Index", new { sortOrder = "datarejestracji_asc", currentFilter = ViewBag.CurrentFilter }
                    , new { Class = "Akcja", title = "Malejąco" })
                </td>
            </tr>
            @foreach (var item in Model)
            {

                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Imie)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nazwisko)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Pesel)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Plec)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DataUrodzenia)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NrTelefonu)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DataRejestracji)
                    </td>
                    <td>
                        @if ((User.Identity.IsAuthenticated && User.Identity.GetUserName() == item.Email)
            || User.IsInRole("Administrator")
            || User.IsInRole("Lekarz"))
                        {
                            @Html.ActionLink(" ", "Edit", new { id = item.ID }, new { @class = "btn btn-primary glyphicon glyphicon-edit", title = "Edycja" }) <span> | </span>
                            @Html.ActionLink(" ", "Delete", new { id = item.ID }, new { @class = "btn btn-info glyphicon glyphicon-trash", title = "Kasuj" }) <span> | </span>
                        }

                        @Html.ActionLink(" ", "Details", new { id = item.ID }, new { @class = "btn btn-success glyphicon glyphicon-align-justify", title = "Więcej" })

                    </td>
                </tr>
            }

        </table>

        <br />

        <div id="pagination-postion">
            <div class="count">
                Strona @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) z @Model.PageCount
            </div>
            @Html.PagedListPager(Model, page => Url.Action("Index",
                        new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))
        </div>

        <div class="text-center">
            Wszystkich: @Model.TotalItemCount
        </div>

    </div>
}
else
{
    <div> Nic nie znaleziono</div>
}

<link href="~/Content/PginationPosition.css" rel="stylesheet" />