@model DateTime?


@{ 
    var uid = Guid.NewGuid();
}

@Html.TextBox(
       string.Empty,
       Model.HasValue ? Model.Value.ToString("MMM d, yyyy") : string.Empty,
       new {@id = uid}
    )

@Html.Display(
       string.Empty,
       Model.HasValue ? Model.Value.ToString("MMM d, yyyy") : string.Empty,
       new { @id = uid }
    )

<script type="text/javascript">
    $("#@uid").datepicker({dateFormat: 'M d, yy'});
</script>