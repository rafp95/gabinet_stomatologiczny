@model DateTime?

@{
    var uid = Guid.NewGuid();
}

@Html.TextBox(
    string.Empty,
    Model.HasValue ? Model.Value.ToString("yyyy.MM.dd") : string.Empty,
    new { @id = uid, placeholder = "yyyy.mm.dd", autocomplete = "off" })
<script type="text/javascript">

    function wypisz() {
        $("#@uid").datepicker(
           {
               dateFormat: 'yy.mm.dd',
               yearRange: "-100:+0",
               changeMonth: true,
               changeYear: true,
               selectOtherMonths: true,
               showAnim: 'slideDown'
           }
        ).addClass("form-control");
    }
    wypisz();

</script>