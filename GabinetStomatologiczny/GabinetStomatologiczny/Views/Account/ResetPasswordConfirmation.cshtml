@{
    ViewBag.Title = "Potwierdzenie zmiany hasła";
}

<div class="row serverResult">
    <div class="col-sm-12 col-md-12">
        <div class="panel panel-success">
            <div class="panel-heading">
                <hgroup class="title">
                    <h1>@ViewBag.Title.</h1>
                </hgroup>
            </div>
            <div class="panel-body">
                <div>
                    <p>
                        Twoje hasło zostało zmienione aby zalogować się kliknij tu @Html.ActionLink("Kliknij aby się zalogować", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section MyCustomStyle{
    <link href="~/Content/ErrorStylePage.min.css" rel="stylesheet" />
}