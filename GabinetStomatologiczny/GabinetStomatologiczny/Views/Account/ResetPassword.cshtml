@model GabinetStomatologiczny.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Zmiana hasła";
}

<header class="alert alert-info headerInfo"><div>@ViewBag.Title</div></header>

<div class="panel panel-primary">
    <div class="panel panel-heading panel-primary">
        <h4>Zmień swoje hasło.</h4>
    </div>
    <div class="panel pnel-body">
        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            <hr />
            @Html.ValidationSummary("", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Code)
            <div class="form-group">
                @Html.LabelFor(m => m.Email, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.Email)
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", @id = "Haslo" })
                    @Html.ValidationMessageFor(m => m.Password)
                    <span id="InfoPassword"></span>
                    <div id="myProgress">
                        <div id="myBar"></div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword)
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" class="btn btn-block btn-default" value="Resetuj" />
                </div>
            </div>
        }
    </div>
</div>

<link href="~/Content/SilaHasla.css" rel="stylesheet" />

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/script/SilaHasla.js"></script>
}
