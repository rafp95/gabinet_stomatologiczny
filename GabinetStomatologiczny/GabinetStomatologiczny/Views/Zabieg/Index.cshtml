@model IEnumerable<GabinetStomatologiczny.DAO.Models.Zabieg>

@{
    ViewBag.Title = "Zabiegi";
    ViewBag.Active = "Pacjenci";
}

<header class="alert alert-info headerInfo"><div>Zabiegi</div></header>

@if (TempData["zabiegOperationSucess"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @TempData["zabiegOperationSucess"]
    </div>
}

@if (User.IsInRole("Pacjent") &&
                                                                                        Model.Any(m => m.Wizyta.Pacjent.Email == User.Identity.Name))
{
    <div style="margin-bottom: 20px;">
        Genruj PDF :
        <a href="@Url.Action("/RaportPdf")" target="_blank" class="btn btn-success">
            <span class="glyphicon glyphicon-print"></span> Generuj raport
        </a>
    </div>
}
else if (User.IsInRole("Administrator")
                || User.IsInRole("Lekarz"))
{
    <form id="wyslij" class="wyszukiwarka" method="get" data-ajax="true">
        <div class="form-group">
            <div class="col-12">
                <span id="searchclear" class="glyphicon glyphicon-remove-circle kasujText kasujTextZabieg"></span>
                <input type="text" id="searchQuery" name="searchQuery"
                       data-autocomplete-source="@Url.Action("Sugestions")" placeholder="Wpisz min 1 znak"
                       class="form-control zabieg-query" value="@ViewBag.currentFilter" />
                <button type="submit" data-toggle="tooltip" title="Wyszukaj" class="szukajZabiegAjax form-control tooltipLink">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
    </form>
}

@Html.Partial("_ZabiegsPartial")

@section MyCustomStyle{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/Content/TableStyle.min.css" rel="stylesheet" />
    <link href="~/Content/Wyszukiwarka.min.css" rel="stylesheet" />
    <link href="~/Content/Zabieg.min.css" rel="stylesheet" />
    <link href="~/Content/PginationPosition.min.css" rel="stylesheet" />
}


@section scripts{
    <script src="~/Scripts/custom/WyszukiwanieAjaxowe.es5.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/custom/AutoComplete.es5.min.js"></script>
}