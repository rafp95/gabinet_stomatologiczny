<div class="navbar navbar-inverse navbar-fixed-top" role="navigation">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
                <span class="icon-bar top-bar"></span>
                <span class="icon-bar middle-bar"></span>
                <span class="icon-bar bottom-bar"></span>
            </button>
            @Html.ActionLink("Gabinet", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
        </div>
        <div class="navbar-collapse collapse" id="bs-example-navbar-collapse-1">
            <ul class="nav navbar-nav">
                <li class="@(ViewBag.Active=="Home"? "active" : "")">
                    <a href="/Home/Index"><i class="glyphicon glyphicon-home" style="font-size:14px;"></i> Home</a>
                </li>
                <li class="@(ViewBag.Active == "About" ? "active" : "")">@Html.ActionLink("About", "About", "Home")</li>
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="dropdown @(ViewBag.Active == "Pacjenci" ? "active" : "")">
                        <a href="@Url.Action("Index", "Pacjenci")" class="dropdown-toggle" data-toggle="dropdown">
                            Osoby <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li class="@(ViewBag.Title == "Pacjenci" ? "active" : "")">@Html.ActionLink("Pacjenci", "Index", "Pacjents")</li>
                            <li class="@(ViewBag.Title == "Zabiegi" ? "active" : "")">@Html.ActionLink("Zabiegi", "Index", "Zabiegs")</li>
                            <li class="@(ViewBag.Title == "Lekarze" ? "active" : "")">@Html.ActionLink("Lekarze", "Index", "Lekarzs")</li>
                        </ul>
                    </li>
                }
                <li class="@(ViewBag.Active == "Wizytas" ? "active" : "")">@Html.ActionLink("Wizyty", "Index", "Wizytas")</li>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Administrator"))
                {
                    <li class="@(ViewBag.Active=="Rejestracja" ? "active" : "")"><a href="/Rejestracja/Index"> <span class="glyphicon glyphicon-user" style="font-size:14px;"></span>  Nowe konto </a> </li>
                }
            </ul>
            @Html.Partial("_LoginPartial")
        </div>
    </div>
</div>

