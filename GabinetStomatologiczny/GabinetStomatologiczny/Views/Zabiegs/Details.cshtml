@model GabinetStomatologiczny.DAO.Models.Zabieg

@{
    ViewBag.Title = "Wiecej";
    ViewBag.Active = "Pacjenci";
}

<header class="alert alert-info headerInfo"><div>Więcej o @ViewBag.User</div></header>
<div>
    <h4>Zabieg</h4>
    <hr />
    <dl class="dl-horizontal">

        <dt>
            @Html.DisplayNameFor(model => model.TypZabiegu)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TypZabiegu)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.CenaZabiegu)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CenaZabiegu)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ZabiegDate)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.ZabiegDate)
        </dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Edycja", "Edit", new { id = Model.ID },new {@class= "btn btn-info" }) |
    @Html.ActionLink("Wstecz", "Index",null,new {@class= "glyphicon glyphicon-hand-left" })
</p>

@section scripts{
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
}