@model GabinetStomatologiczny.DAO.Models.Zabieg

@{
    ViewBag.Title = "Kasuj";
}

<header class="alert alert-info headerInfo"><div>@ViewBag.Title @ViewBag.User</div></header>
<h3>Jeseś pewny?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">

        <dt>
            @Html.DisplayNameFor(model => model.TypZabiegu)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TypZabiegu)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.CenaZabiegu)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CenaZabiegu)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ZabiegDate)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.ZabiegDate)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Kasuj" class="btn btn-default" /> |
            @Html.ActionLink("Wstecz", "Index",null,new {@class= "glyphicon glyphicon-hand-left" })
        </div>
    }
</div>

@section scripts{
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
}