@model GabinetStomatologiczny.DAO.Models.Lekarz
@{
    ViewBag.Title = "Więcej";
    ViewBag.Active = "Pacjenci";
}
<header class="alert alert-info headerInfo"><div>Więcej informacji</div></header>
<div>
    <h4>Lekarz</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Imie)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Imie)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Nazwisko)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Nazwisko)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Zdjecie)
        </dt>
        <dd>
            @if (Model.Zdjecie != null)
            {
                <img src="~/Obrazki/@Html.DisplayFor(modelItem => Model.Zdjecie)" id="myImg" class="rozmiar" />
                <div id="myModal" class="modal">
                    <span class="close">&times;</span>
                    <img class="modal-content" id="img01">
                    <div id="caption"></div>
                </div>
            }
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.NrTelefonu)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.NrTelefonu)
        </dd>
    </dl>
</div>
<p>
    @if (User.Identity.Name == Model.Email || User.IsInRole("Administrator"))
    {
        @Html.ActionLink("Edycja", "Edit", new { id = Model.ID }, new { @class = "btn btn-info" })
        <span> | </span>
    }
    @Html.ActionLink(" Wstecz", "Index", null, new { @class = "glyphicon glyphicon-hand-left" })
</p>
@section MyCustomStyle{
    <link href="~/Content/Zdjecia.min.css" rel="stylesheet" />
}
@section scripts{
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script src="~/Content/script/Zdjecia.js"></script>
}