@model PagedList.IPagedList<GabinetStomatologiczny.DAO.Models.Lekarz>
@{
    ViewBag.Title = "Lekarz";
    ViewBag.Active = "Pacjenci";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/Lekarzs.css" rel="stylesheet" />
<link href="@Url.Content("~/Content/Zdjecia.css")"  rel="stylesheet"/>
<link href="@Url.Content("~/Content/TableStyle.css")" rel="stylesheet" />
<link href="~/Content/Wyszukiwarka.css" rel="stylesheet" />
<link href="~/Content/themes/base/jquery-ui.css" rel="stylesheet" />

@section scripts{
    <script src="~/Content/script/WyszykiwanieAjaxLekarz.js"></script>
    <script src="~/Content/script/Zdjecia.js"></script>
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

    <script>
        function setupAutoComplete() {
            var input = $("#searchQuery");

            var options = {
                source: input.attr("data-autocomplete-source"),
                select: function (event, ui) {
                    input.val(ui.label);
                    var form = input.parents("form:first");
                    form.submit();
                }
            };

            input.autocomplete(options);
        };

        setupAutoComplete();
    </script>
}

<h2>Lekarz</h2>

<div class="form-group">
    <form id="wyslij" class="wyszukiwarka" method="get" data-ajax="true">
        <span id="searchclear" class="glyphicon glyphicon-remove-circle kasujText"></span>
        <input type="text" id="searchQuery" name="searchQuery" data-autocomplete-source="@Url.Action("SugestionsLekarzs")"
                placeholder="Wpisz min 1 znak" class="form-control"/>
        <button type="submit" data-toggle="tooltip" title="Wyszukaj" class="szukajLekarzaAjax form-control"><i class="fa fa-search"></i></button>
    </form>
</div>

@Html.Partial("_LekarzsParts")

