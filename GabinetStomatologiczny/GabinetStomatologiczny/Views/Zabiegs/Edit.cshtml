@model GabinetStomatologiczny.DAO.Models.Zabieg

@{
    ViewBag.Title = "Edycja";
    ViewBag.Active = "Pacjenci";
}

<div id="saveDatabaseInfo"></div>
<div class="ladowanie"></div>

<ul class="nav nav-tabs">
    <li class="active"><a data-toggle="tab" href="#home">Model zębów</a></li>
    <li><a data-toggle="tab" href="#menu1">Zabiegi</a></li>
</ul>

<div class="tab-content">
    <div id="home" class="tab-pane fade in active">
        <h2 class="text-center">Model zębów pacjęta @Model.Wizyta.Tytul</h2>
        <div class="row">
            <div class="col-sm-12 col-md-12">
                @Html.Partial("_ToothModelParital")
            </div>
        </div>
        @Html.Partial("_RefreshPage")
    </div>
    <div id="menu1" class="tab-pane fade">
        <div class="row centerPage">
            <h3>Zabieg pacjęta @Model.Wizyta.Tytul</h3>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal position-label">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.ID)
                    @Html.HiddenFor(model => model.WizytaID)

                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.LabelFor(model => model.Wizyta.Tytul, htmlAttributes: new { @class = "control-label col-md-2" })
                            @Html.EditorFor(model => model.Wizyta.Tytul, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                            @Html.ValidationMessageFor(model => model.Wizyta.Tytul, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.LabelFor(model => model.TypZabiegu, htmlAttributes: new { @class = "control-label col-md-2" })
                            @Html.EnumDropDownListFor(model => model.TypZabiegu, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.TypZabiegu, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.LabelFor(model => model.CenaZabiegu, htmlAttributes: new { @class = "control-label col-md-2" })
                            @Html.EditorFor(model => model.CenaZabiegu, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CenaZabiegu, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10 zabiegAddEdit">
                            <input type="submit" value="Zapisz" class="btn btn-block btn-default" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div>
    @Html.ActionLink("Wstecz", "Index", null, new { @class = "glyphicon glyphicon-hand-left" })
</div>

@section MyCustomStyle{
    <link href="~/Content/ZabiegCreate.min.css" rel="stylesheet" />
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script src="~/Content/script/ModelZebow.js"></script>
}
