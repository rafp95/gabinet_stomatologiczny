<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="description" content="Gabinet stomatologiczny">
    <meta name="keywords" content="Gabinet">
    <meta name="author" content="Patryk Rafał">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title </title>
    <link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/fullcalendarcss")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/DLandDDstyle.min.css" rel="stylesheet" />
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/Notyfication.min.css" rel="stylesheet" />
    @if (IsSectionDefined("MyCustomStyle"))
    {
        @RenderSection("MyCustomStyle", required: false)
    }
</head>
<body>
    <!--main page loader-->
    <div class="main-loader"></div>
    <!--end main page loader-->
    <!--nav-->
    @Html.Partial("_NavBar")
    <!--end nav-->
    <!--main content-->
    <div class="container body-content">
        <div id="status"></div>
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year Patryk Rafał </p>
        </footer>
    </div>
    <!--end main content-->
    <!--to top page-->
    <a id="back-to-top" href="#" class="btn btn-primary btn-lg back-to-top tooltipLink" role="button"
       title="Do góry" data-placement="Top" data-toggle="tooltip">
        <span class="glyphicon glyphicon-chevron-up"></span>
    </a>
    <!--end to top page-->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/fullcalendarjs")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/custom/GlobalCustomScript.es5.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.3.0.min.js"></script>
    <script src="/signalr/hubs"></script>
    <script src="~/Scripts/custom/Notyfication.es5.min.js"></script>
</body>
</html>
