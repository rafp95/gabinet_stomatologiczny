@model PagedList.IPagedList<GabinetStomatologiczny.DAO.Models.Pacjent>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Pacjenci";
    ViewBag.Active = "Pacjenci";
}

<header class="alert alert-info headerInfo"><div>Pacjenci</div></header>

@if (TempData["sucessOperation"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @TempData["sucessOperation"]
    </div>
}

@if ( User.IsInRole("Lekarz") || User.IsInRole("Administrator") )
{
    <div class="form-group">
        <form id="wyslij" class="wyszukiwarka" method="get" data-ajax="true">
            <span id="searchclear" class="glyphicon glyphicon-remove-circle kasujText kasujTextPacjent"></span>
            <input type="text" id="searchQuery" name="searchQuery"
                   data-autocomplete-source="@Url.Action("Sugestions")" placeholder="Wpisz min 1 znak"
                   class="form-control pacjent-query" value="@ViewBag.currentFilter" />
            <button type="submit" data-toggle="tooltip" title="Wyszukaj" class="szukajPacjentAjax form-control tooltipLink"><i class="fa fa-search"></i></button>
        </form>
    </div>
}

@Html.Partial("_PatiensParts")

@section MyCustomStyle{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/Content/TableStyle.min.css" rel="stylesheet" />
    <link href="~/Content/Wyszukiwarka.min.css" rel="stylesheet" />
    <link href="~/Content/Pacjent.min.css" rel="stylesheet" />
    <link href="~/Content/PginationPosition.min.css" rel="stylesheet" />
}


@section scripts{
    <script src="~/Scripts/custom/WyszukiwanieAjaxowe.es5.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/custom/AutoComplete.es5.min.js"></script>
}